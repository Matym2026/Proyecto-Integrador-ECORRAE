# Conexión a PostgreSQL local (en AWS será el endpoint de RDS leído desde Secrets Manager)
DATABASE_URL=postgresql+psycopg://ecoraee:ecoraee123@localhost:5432/ecoraee

# Carpeta local que simula el bucket S3 de evidencias
STORAGE_DIR=./storage

# Origen del frontend permitido por CORS
FRONTEND_ORIGIN=http://localhost:5173

# Tamaño máximo de evidencia en MB
MAX_UPLOAD_MB=10
